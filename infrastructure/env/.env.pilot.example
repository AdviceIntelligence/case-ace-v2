# Pilot Deployment Environment Configuration
# Pinned to europe-west2 (London). Production-grade telemetry & Entra ID OIDC.
APP_ENV=pilot
PORT=8080
GCP_REGION=europe-west2
GCP_PROJECT_ID=case-ace-v2
VITE_APP_ENV=pilot
CORS_ORIGIN=https://caseace.adviceintelligence.tech,https://api.caseace.adviceintelligence.tech
WEBEX_REDIRECT_URI=https://caseace.adviceintelligence.tech/api/auth/webex/callback
ENTRA_REDIRECT_URI=https://caseace.adviceintelligence.tech/auth/callback

# Login route while the Entra ID tenant is unavailable. Set to false (or remove) to
# switch the pilot to Entra ID SSO without a code change.
ALLOW_TOTP_IN_PILOT=true

# NEVER commit a real value. Injected from Secret Manager at deploy time
# (secret name: case-ace-jwt-secret). Minimum 32 characters.
JWT_SECRET=
